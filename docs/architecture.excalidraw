      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hugging Face rate-limits\nMotherDuck's parallel reads\n(HTTP 429), so the parquet\nis staged in plain S3 first.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
